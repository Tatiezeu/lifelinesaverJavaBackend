<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="LifelinePU" transaction-type="JTA">
        <!-- Some environments use the name directly, others use jdbc/ prefix. 
             Given the previous success pinging 'LifelinePool', we use it directly. -->
        <jta-data-source>jdbc/LifelinePool</jta-data-source>
        <class>com.lifeline.entity.User</class>
        <class>com.lifeline.entity.EmergencyAlert</class>
        <class>com.lifeline.entity.ClientProfile</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="eclipselink.target-database" value="Oracle"/>
            <property name="eclipselink.logging.level" value="FINE"/>
        </properties>
    </persistence-unit>
</persistence>
